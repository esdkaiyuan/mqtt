# ========== 构建阶段 ==========
# 构建上下文为仓库根目录（见 docker/docker-compose.yml 的 build.context）
FROM maven:3.9-eclipse-temurin-17-alpine AS builder
WORKDIR /build

# 先解析依赖，命中缓存后可跳过重复下载
COPY backend/pom.xml ./
RUN mvn -B -DskipTests dependency:resolve

COPY backend/src ./src
RUN mvn -B clean package -DskipTests

# ========== 运行阶段 ==========
FROM eclipse-temurin:17-jre-alpine

RUN apk add --no-cache curl \
    && addgroup -S app \
    && adduser -S -G app app

WORKDIR /app
COPY --from=builder /build/target/*.jar app.jar
# 预建 OTA 固件目录并归属 app 用户：命名卷首次挂载到已存在目录时会继承该目录属主，
# 否则空卷由 Docker 以 root 创建，非 root 的 app 用户无法写入（T-22）
RUN chown -R app:app /app \
    && mkdir -p /var/lib/mqtt/ota \
    && chown -R app:app /var/lib/mqtt

USER app
EXPOSE 8080

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -Djava.security.egd=file:/dev/./urandom"
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]