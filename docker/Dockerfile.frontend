# ========== 构建阶段 ==========
# 构建上下文为仓库根目录（见 docker/docker-compose.yml 的 build.context）
# Node 版本要求 ≥20.19：unplugin@3.x（unplugin-auto-import / unplugin-vue-components 的依赖）
# 声明 engines.node ^20.19.0 || >=22.12.0，Node 18 下 vite.config.js 加载会失败。
FROM node:22-alpine AS builder
WORKDIR /build

COPY frontend/package.json frontend/package-lock.json ./
# 构建依赖 vite 属于 devDependencies，不能只装生产依赖
RUN npm ci --no-audit --no-fund

COPY frontend/ ./
RUN npm run build

# ========== 运行阶段 ==========
FROM nginx:alpine

RUN apk add --no-cache curl

COPY --from=builder /build/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]