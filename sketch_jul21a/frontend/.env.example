# 前端环境配置（复制为 .env 使用）
#
# 开发期由 vite.config.js 把 /api 与 /ws 代理到 VITE_PROXY_TARGET，
# 因此默认保持同源相对路径即可，无需写死后端地址。

# REST 前缀（api.js 读取）
VITE_API_BASE=/api

# WebSocket 前缀；留空表示使用当前页面的 origin（websocket.js 读取）
VITE_WS_BASE=

# 开发服务器代理目标（vite.config.js 通过 process.env 读取，需在 shell 中导出）
VITE_PROXY_TARGET=http://localhost:8000