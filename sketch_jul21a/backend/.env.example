# Fall Detection System Backend Configuration
# Copy this file to .env and update values

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fall_detection
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/fall_detection

# Application Settings
APP_NAME=Fall Detection System
APP_VERSION=1.0.0
DEBUG=true

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Fall Detection Parameters
FALL_WINDOW_SIZE=50
FALL_ACCEL_THRESHOLD=2.5
FALL_GYRO_THRESHOLD=300.0
FALL_SAMPLE_RATE=100

# Data Retention (optional, in days)
DATA_RETENTION_DAYS=365
