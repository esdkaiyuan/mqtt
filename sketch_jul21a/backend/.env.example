# Fall Detection System — backend configuration
# Copy to `.env` and adjust. Values below match the local development default
# (SQLite, no external database required).

# --- Database -------------------------------------------------------------
# SQLite (default, zero setup)
DATABASE_URL=sqlite+aiosqlite:///./fall_detection.db
DATABASE_URL_SYNC=sqlite:///./fall_detection.db
# PostgreSQL (used by docker-compose)
# DATABASE_URL=postgresql+asyncpg://fall_user:fall_password@localhost:5432/fall_detection
# DATABASE_URL_SYNC=postgresql://fall_user:fall_password@localhost:5432/fall_detection

# --- Application ----------------------------------------------------------
APP_NAME=Fall Detection System
APP_VERSION=1.0.0
DEBUG=true

# --- CORS (JSON array) ----------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# --- Fall detection parameters -------------------------------------------
FALL_WINDOW_SIZE=50
FALL_ACCEL_THRESHOLD=2.5
FALL_GYRO_THRESHOLD=300.0
FALL_SAMPLE_RATE=100

# --- Data retention (days) ------------------------------------------------
DATA_RETENTION_DAYS=365