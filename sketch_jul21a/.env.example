# 摔倒检测系统环境配置

# 数据库配置
DATABASE_URL=postgresql://fall_user:fall_password@localhost:5432/fall_detection

# 后端配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# 前端配置
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ESP32配置
ESP32_WIFI_SSID=8202
ESP32_WIFI_PASSWORD=88888888
ESP32_WS_SERVER=192.168.1.100
ESP32_WS_PORT=8000

# 摔倒检测参数
FALL_DETECTION_ACCELERATION_THRESHOLD=2.5
FALL_DETECTION_ANGULAR_VELOCITY_THRESHOLD=300
FALL_DETECTION_WINDOW_SIZE=50
