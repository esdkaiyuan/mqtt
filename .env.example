# ============================================================
# MQTT云平台 - 环境变量配置模板
# 使用方式：cp .env.example .env 后按需修改
# 说明：docker compose 会读取本文件做变量替换，请勿提交真实密钥
# ============================================================

# ========== 数据库配置 ==========
DB_ROOT_PASSWORD=root_password
DB_NAME=mqtt_cloud
DB_PORT=3306
DB_USERNAME=root

# ========== Redis配置 ==========
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== MQTT配置 ==========
MQTT_PORT=1883
MQTT_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
# EMQX Dashboard 账号，scripts/emqx-init.sh 用它调用 EMQX REST API 下发认证/授权配置
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=public
# 说明：后端连接 Broker 使用平台账号（用户名固定为 PLATFORM，密码即下方 PLATFORM_SECRET），
# 设备使用一机一密账号 {productKey}.{deviceKey}，不再使用固定的 admin/public。

# ========== 后端配置 ==========
# 后端副本数（水平扩展）。>1 时各副本 MQTT_SHARED_GROUP 必须一致以分摊消息避免重复落库，
# 且需 REALTIME_BROADCAST_ENABLED=true 才能把实时数据投递到订阅在其他副本上的前端。
# 注意：后端不再发布宿主机端口，统一经 nginx 网关（FRONTEND_PORT）访问 /api。
BACKEND_REPLICAS=1
# JWT 签名密钥：Base64 编码，解码后不得少于 32 字节
# 留空时 scripts/deploy.sh 会自动生成；也可手动执行 openssl rand -base64 48
JWT_SECRET=

# ========== 前端配置 ==========
FRONTEND_PORT=80

# ========== 接入访问控制（T-11 设备接入与身份体系） ==========
# 内部接口共享令牌：后端校验、EMQX HTTP 认证/授权回调携带，二者必须一致
INTERNAL_TOKEN=change-me-internal-token
# 平台账号密码：后端自身连接 Broker 使用（MQTT 用户名固定为 PLATFORM）
PLATFORM_SECRET=change-me-platform-secret
# 迁移期前端直连 Broker 的受限账号密码，配合 DIRECT_FRONTEND_ENABLED 使用
FRONTEND_SECRET=change-me-frontend-secret
# 迁移开关 1/2：false=双轨期，认证与授权回调一律放行，存量设备老凭据仍可用；
# 存量设备全部刷机完成后必须置 true，届时仅一机一密凭据可接入。
ACCESS_CONTROL_ENFORCE_AUTH=false
# 迁移开关 2/2：是否保留前端直连 Broker 的受限账号；前端已切 SSE，确认后置 false。
DIRECT_FRONTEND_ENABLED=true
# 认证元数据缓存 TTL（秒）：认证热路径的产品/设备元数据缓存在 Redis；0 关闭缓存。
# 主动失效覆盖密钥重置与设备/产品变更；若 Redis 不可用，旧凭据最长该时长内仍可能通过认证。
ACCESS_CONTROL_CACHE_TTL_SECONDS=60
# SSE 连接超时（毫秒），0 表示不超时；默认 30 分钟
STREAM_TIMEOUT_MS=1800000
# SSE 服务端心跳间隔（毫秒），必须小于网关空闲超时（nginx 侧为 1h），用于保活与探测死连接
STREAM_HEARTBEAT_INTERVAL_MS=15000
# 实时通道跨副本广播：多副本部署必须为 true（经 Redis Pub/Sub 广播）；单副本可保持 false
REALTIME_BROADCAST_ENABLED=false
# 跨副本广播使用的 Redis 频道名，多副本间必须一致
REALTIME_BROADCAST_CHANNEL=mqtt:realtime:device-data
# MQTT 共享订阅组名：多副本部署时同一组内的副本分摊消息（EMQX 默认 round_robin），避免重复落库
MQTT_SHARED_GROUP=mqtt-backend

# ========== 运行 profile ==========
# 生产固定为 prod：收敛日志级别、关闭 SQL 输出、收紧 health 明细。
# 仅本地排障时临时改为 dev，切勿在部署环境使用。
SPRING_PROFILES_ACTIVE=prod