# ============================================================
# MQTT云平台 - 环境变量配置模板
# 使用方式：cp .env.example .env 后按需修改
# 说明：docker compose 会读取本文件做变量替换，请勿提交真实密钥
# ============================================================

# ========== 数据库配置 ==========
DB_ROOT_PASSWORD=root_password
DB_NAME=mqtt_cloud
DB_PORT=3306
DB_USERNAME=root

# ========== Redis配置 ==========
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== MQTT配置 ==========
MQTT_PORT=1883
MQTT_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
MQTT_USERNAME=admin
MQTT_PASSWORD=public

# ========== 后端配置 ==========
BACKEND_PORT=8080
# JWT 签名密钥：Base64 编码，解码后不得少于 32 字节
# 留空时 scripts/deploy.sh 会自动生成；也可手动执行 openssl rand -base64 48
JWT_SECRET=

# ========== 前端配置 ==========
FRONTEND_PORT=80
# 浏览器直连 MQTT 的 WebSocket 地址（构建期注入前端产物）
VITE_MQTT_URL=ws://localhost:8083/mqtt