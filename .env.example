# ============================================================
# MQTT云平台 - 环境变量配置模板
# 使用方式：cp .env.example .env 后按需修改
# 说明：docker compose 会读取本文件做变量替换，请勿提交真实密钥
# ============================================================

# ========== 数据库配置 ==========
DB_ROOT_PASSWORD=root_password
DB_NAME=mqtt_cloud
DB_PORT=3306
DB_USERNAME=root

# ========== Redis配置 ==========
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== MQTT配置 ==========
MQTT_PORT=1883
MQTT_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
# EMQX Dashboard 账号，scripts/emqx-init.sh 用它调用 EMQX REST API 下发认证/授权配置；
# 后端禁用 / 停用设备时也用它换取 token 调用踢线接口，二者必须一致
EMQX_DASHBOARD_USER=admin
EMQX_DASHBOARD_PASSWORD=public
# 说明：后端连接 Broker 使用平台账号（用户名固定为 PLATFORM，密码即下方 PLATFORM_SECRET），
# 设备使用一机一密账号 {productKey}.{deviceKey}，不再使用固定的 admin/public。

# ========== 后端配置 ==========
# 后端副本数（水平扩展）。>1 时各副本 MQTT_SHARED_GROUP 必须一致以分摊消息避免重复落库，
# 且需 REALTIME_BROADCAST_ENABLED=true 才能把实时数据投递到订阅在其他副本上的前端。
# 注意：后端不再发布宿主机端口，统一经 nginx 网关（FRONTEND_PORT）访问 /api。
BACKEND_REPLICAS=1
# JWT 签名密钥：Base64 编码，解码后不得少于 32 字节
# 留空时 scripts/deploy.sh 会自动生成；也可手动执行 openssl rand -base64 48
JWT_SECRET=

# ========== 前端配置 ==========
FRONTEND_PORT=80

# ========== 接入访问控制（T-11 设备接入与身份体系） ==========
# 内部接口共享令牌：后端校验、EMQX HTTP 认证/授权回调携带，二者必须一致
INTERNAL_TOKEN=change-me-internal-token
# 平台账号密码：后端自身连接 Broker 使用（MQTT 用户名固定为 PLATFORM）
PLATFORM_SECRET=change-me-platform-secret
# 迁移期前端直连 Broker 的受限账号密码，配合 DIRECT_FRONTEND_ENABLED 使用
FRONTEND_SECRET=change-me-frontend-secret
# 迁移开关 1/2：false=双轨期，认证与授权回调一律放行，存量设备老凭据仍可用；
# 存量设备全部刷机完成后必须置 true，届时仅一机一密凭据可接入。
ACCESS_CONTROL_ENFORCE_AUTH=false
# EMQX 授权结果缓存 TTL（由 emqx-init 下发）。禁用/停用后已连接会话的收发被拒，
# 最长需等该缓存过期；调小可缩短收敛窗口，代价是后端 ACL 回调次数增加。
ACL_CACHE_TTL=10s
# 迁移开关 2/2：是否保留前端直连 Broker 的受限账号；前端已切 SSE，确认后置 false。
DIRECT_FRONTEND_ENABLED=true
# 认证元数据缓存 TTL（秒）：认证热路径的产品/设备元数据缓存在 Redis；0 关闭缓存。
# 主动失效覆盖密钥重置与设备/产品变更；若 Redis 不可用，旧凭据最长该时长内仍可能通过认证。
ACCESS_CONTROL_CACHE_TTL_SECONDS=60

# ── T-30 开放接口限流 ──
# 仅作用于 /external/v1/**，按 API Key 固定窗口计数。
# 默认关闭：未显式开启时不限流，避免演示/迁移环境的正常调用被打成 429。
# 正式对外提供服务前应置true，并按实际配额调整 max-requests。
RATE_LIMIT_ENABLED=false
# 固定窗口长度（秒）
RATE_LIMIT_WINDOW_SECONDS=60
# 单个 API Key 在一个窗口内的最大调用次数
RATE_LIMIT_MAX_REQUESTS=600
# Redis 不可用时是否放行（true=可用性优先，限流降级；false=严格限流）
RATE_LIMIT_FAIL_OPEN=true

# ── T-30 健康检查阈值 ──
# 摄取队列总深度超过该值即判 readiness DOWN，交监控告警而非自动重启
HEALTH_QUEUE_DEPTH_THRESHOLD=5000
# PENDING 死信条数超过该值即判 readiness DOWN（死信意味着上行消息在丢失）
HEALTH_DEAD_LETTER_THRESHOLD=1000

# ── T-30 结构化日志 ──
# 日志落盘目录（容器内已挂backend_logs 卷；本机裸跑时用相对路径）
LOG_DIR=/var/log/mqtt-cloud

# 禁用 / 停用时是否调用 EMQX 踢线接口（DELETE /api/v5/clients/{clientid}）立即断开已连接会话。
# 置 false 时不做踢线，仅依赖 ACL_CACHE_TTL 收敛收发权限，连接态则要等设备下次认证。
EMQX_KICK_ENABLED=true
# SSE 连接超时（毫秒），0 表示不超时；默认 30 分钟
STREAM_TIMEOUT_MS=1800000
# SSE 服务端心跳间隔（毫秒），必须小于网关空闲超时（nginx 侧为 1h），用于保活与探测死连接
STREAM_HEARTBEAT_INTERVAL_MS=15000
# 实时通道跨副本广播：多副本部署必须为 true（经 Redis Pub/Sub 广播）；单副本可保持 false
REALTIME_BROADCAST_ENABLED=false
# 跨副本广播使用的 Redis 频道名，多副本间必须一致
REALTIME_BROADCAST_CHANNEL=mqtt:realtime:device-data
# MQTT 共享订阅组名：多副本部署时同一组内的副本分摊消息（EMQX 默认 round_robin），避免重复落库
MQTT_SHARED_GROUP=mqtt-backend

# ========== 物模型与上行解析（T-14） ==========
# 上行解析总开关：置 false 时只落原始消息，物模型解析链路整体退化为改造前行为（故障回滚用）
THING_MODEL_INTERPRET_ENABLED=true
# 物模型定义缓存 TTL（秒）：解析热路径缓存产品物模型；0 关闭缓存。
# 保存物模型只失效本副本缓存，多副本之间的收敛窗口 = 该 TTL。
THING_MODEL_CACHE_TTL_SECONDS=60
# 物模型 TSL 大小上限（字节），保存与导入共用，超限直接拒绝（默认 256 KB）
THING_MODEL_MAX_SIZE_BYTES=262144

# ========== 命令下发与服务调用（T-15） ==========
# 同步调用等待回执的超时（毫秒），超时置 TIMEOUT
COMMAND_SYNC_TIMEOUT_MS=5000
# 同步等待的轮询间隔（毫秒）；多副本下回执可能落到其他副本，故轮询命令记录表
COMMAND_POLL_INTERVAL_MS=200
# 超时巡检间隔（毫秒），0 关闭；兜底把长期停留 PENDING/SENT 的记录置 TIMEOUT
COMMAND_TIMEOUT_SWEEP_INTERVAL_MS=30000
# 异步命令判定超时的时长（毫秒），供巡检使用
COMMAND_ASYNC_TIMEOUT_MS=60000
# 命令参数 JSON 大小上限（字节），超限直接拒绝
COMMAND_MAX_PARAMS_BYTES=16384

# ---- T-34 · 命令级权限与调用配额 ----
# 全局危险命令标识符黑名单（逗号分隔，大小写不敏感）。命中的标识符对所有角色拒绝下发，
# 除非该角色在 ROLE_PERMISSIONS 中显式豁免。恢复出厂不可逆，默认入黑名单。
COMMAND_DENIED_IDENTIFIERS=factory_reset

# 命令调用配额：按操作者维度的固定窗口计数，**默认关闭**（与 API Key 限流同样的降级语义）。
# 开启后同步调用（callType=sync）的实际阈值为 max-per-window × sync-multiplier。
COMMAND_QUOTA_ENABLED=false
COMMAND_QUOTA_WINDOW_SECONDS=60
COMMAND_QUOTA_MAX_PER_WINDOW=600
COMMAND_QUOTA_SYNC_MULTIPLIER=1
COMMAND_QUOTA_FAIL_OPEN=true

# ========== 设备影子与离线补发（T-16） ==========
# 上线补发总开关：置 false 时离线期望值仍写 desired，但不再自动补发
SHADOW_RESEND_ENABLED=true
# 补发重试上限，达到该次数仍未成功则置 FAILED
SHADOW_RETRY_MAX_ATTEMPTS=5
# 指数退避基数（毫秒）
SHADOW_RETRY_BASE_DELAY_MS=5000
# 指数退避封顶（毫秒）
SHADOW_RETRY_MAX_DELAY_MS=300000
# 退避重试巡检间隔（毫秒），0 关闭
SHADOW_RETRY_SWEEP_INTERVAL_MS=30000
# 单轮巡检 / 单设备补发批量上限
SHADOW_RESEND_BATCH_SIZE=200
# 影子 CAS 冲突重试次数；耗尽后记 WARN 并放弃本次合并
SHADOW_CAS_RETRY=3
# QUEUED 过期时长（毫秒），0 表示不过期
SHADOW_QUEUE_TTL_MS=0

# ========== 告警中心（T-17） ==========
# 告警评估总开关：置 false 时不评估，离线巡检也不注册（已有活动告警保持原状）
ALERT_ENABLED=true
# 触发通知开关：置 false 时仍落库但不投递 alert.triggered
ALERT_NOTIFY_ENABLED=true
# 恢复通知开关：置 false 时仍置 RECOVERED 但不投递 alert.recovered
ALERT_RECOVER_NOTIFY_ENABLED=true
# 全局默认抑制窗口（秒），规则未单独配置时使用
ALERT_SUPPRESS_WINDOW_SECONDS=300
# 离线巡检间隔（毫秒），0 关闭
ALERT_SWEEP_INTERVAL_MS=30000
# 单轮巡检规则 / 记录处理上限
ALERT_SWEEP_BATCH_SIZE=200

# ========== 消息规则 / 规则引擎（T-19） ==========
# 规则引擎总开关：置 false 时不做条件判定（既有告警与 Webhook 不受影响）
RULE_ENABLED=true
# 单用户规则数上限
RULE_MAX_RULES_PER_USER=200
# 规则定义缓存 TTL（秒），0 关闭缓存；保存只失效本副本，多副本收敛窗口 = 该 TTL
RULE_CACHE_TTL_SECONDS=60
# 动作执行线程池：核心 / 最大线程数、队列容量（满时投递被拒，记录直接置 FAILED）
RULE_EXECUTOR_CORE_SIZE=2
RULE_EXECUTOR_MAX_SIZE=8
RULE_EXECUTOR_QUEUE_CAPACITY=500
# 失败重试上限与指数退避基数 / 封顶（毫秒）
RULE_RETRY_MAX_ATTEMPTS=3
RULE_RETRY_BASE_DELAY_MS=5000
RULE_RETRY_MAX_DELAY_MS=300000
# 重试巡检间隔（毫秒），0 关闭（同时关闭执行记录保留清理）
RULE_SWEEP_INTERVAL_MS=30000
# 单轮巡检处理上限
RULE_SWEEP_BATCH_SIZE=200
# 执行记录保留天数（仅清理终态记录），0 表示不清理
RULE_EXECUTION_RETENTION_DAYS=30
# 出站 HTTP 超时（毫秒）与 HMAC 签名密钥（为空时不下发 X-Signature 头）
RULE_HTTP_TIMEOUT_MS=5000
RULE_HTTP_SECRET=
# 动作配置 / 载荷模板大小上限（字节）
RULE_MAX_PAYLOAD_BYTES=16384
# 外部 MQTT 转发（出站到第三方 Broker，不经自有 EMQX）。
# 未配置第三方 Broker 时请勿置 true，否则连接失败会产生持续告警噪声。
RULE_MQTT_ENABLED=false
RULE_MQTT_BROKER_URL=
RULE_MQTT_CLIENT_ID=mqtt-rule-forwarder
RULE_MQTT_USERNAME=
RULE_MQTT_PASSWORD=
RULE_MQTT_QOS=1
RULE_MQTT_KEEPALIVE=60
RULE_MQTT_CONNECT_TIMEOUT=10

# ========== 属性时序与可视化（T-21） ==========
# 是否写入属性历史：置 false 时趋势图无新数据（历史落库与保留清理均不注册）
PROPERTY_HISTORY_ENABLED=true
# 趋势实时流开关（T-36）：属性上报后经 SSE 推给趋势页实时追加。默认关闭，开启前建议先确认前端已接流。
PROPERTY_HISTORY_STREAM_ENABLED=false
# 聚合查询时间窗跨度上限（天）
PROPERTY_HISTORY_MAX_RANGE_DAYS=31
# 单次查询序列数上限（deviceIds × identifiers）
PROPERTY_HISTORY_MAX_SERIES=20
# 单序列数据点上限（时间跨度 / 桶）
PROPERTY_HISTORY_MAX_POINTS=500
# 历史保留天数（R5 门槛复核输入），0 表示不清理
PROPERTY_HISTORY_RETENTION_DAYS=30
# 是否启用过期历史清理
PROPERTY_HISTORY_CLEANUP_ENABLED=true
# 清理巡检间隔（毫秒），0 关闭
PROPERTY_HISTORY_CLEANUP_INTERVAL_MS=3600000
# 单批删除行数
PROPERTY_HISTORY_CLEANUP_BATCH_SIZE=1000
# 可保存看板：每用户看板数量上限
DASHBOARD_MAX_COUNT=20
# 可保存看板：单看板面板数上限
DASHBOARD_MAX_PANELS=12
# 看板分享（T-46）：每用户分享数量 / 单分享看板数上限
DASHBOARD_MAX_SHARES=20
DASHBOARD_MAX_SHARE_DASHBOARDS=10
# 大屏轮播间隔下限 / 上限（秒）
DASHBOARD_SHARE_INTERVAL_MIN_SECONDS=5
DASHBOARD_SHARE_INTERVAL_MAX_SECONDS=3600

# ========== 设备调试中心（T-37） ==========
# 关闭时 /devices/*/debug/** 不注册（404）
DEBUG_ENABLED=true
# 浏览器 / 上位机可访问的 Broker 主机名或 IP；容器内 spring.mqtt.host 为 emqx，不能直接回显
DEBUG_PUBLIC_BROKER_HOST=localhost
# EMQX WebSocket 监听路径（EMQX 默认 /mqtt）
DEBUG_MQTT_WS_PATH=/mqtt
# 模拟上报单次载荷上限（字节）
DEBUG_MAX_PAYLOAD_BYTES=65536

# ========== 快速上位机（T-38） ==========
# 每用户上位机数量上限
HMI_MAX_COUNT=20
# 单个上位机控件数量上限
HMI_MAX_WIDGETS=30

# ========== 平台侧 Modbus 主站采集（T-31 P4） ==========
# 总开关：默认关闭，确认平台到现场网络可达后再开启
MODBUS_COLLECT_ENABLED=false
# 巡检间隔（毫秒）
MODBUS_SWEEP_INTERVAL_MS=1000
# 单轮点位 / 设备上限
MODBUS_BATCH_LIMIT=200
MODBUS_ENABLED_DEVICE_LIMIT=50
# 并发连接与超时
MODBUS_MAX_CONNECTIONS=8
MODBUS_CONNECT_TIMEOUT_MS=3000
MODBUS_READ_TIMEOUT_MS=3000
MODBUS_RETRY=1
# 采集周期下限（点表配置更小时按此值轮询，防止打爆现场总线）
MODBUS_MIN_INTERVAL_MS=1000
# 采集专用线程池
MODBUS_CORE_POOL_SIZE=2
MODBUS_MAX_POOL_SIZE=4
MODBUS_QUEUE_CAPACITY=200
# driver_config 缺省值；host 留空表示必须由产品配置提供
MODBUS_DEFAULT_HOST=
MODBUS_DEFAULT_PORT=502
MODBUS_DEFAULT_UNIT_ID=1

# ========== OTA 固件升级（T-22） ==========
# 升级总开关：置 false 时不下发、不巡检（固件包上传与任务创建仍可用）
OTA_ENABLED=true
# 固件包存储根目录（容器内路径），对应命名卷 ota_firmware
OTA_STORAGE_DIR=/var/lib/mqtt/ota
# 固件下载地址前缀：下发 url = {OTA_PUBLIC_BASE_URL}/{productId}/{version}/{fileName}。
# 默认经 nginx 网关（frontend 容器的 /firmware/ 静态托管，共享同一命名卷）。
OTA_PUBLIC_BASE_URL=http://localhost/firmware
# 单固件包大小上限（字节，默认 32MB）；须不大于 nginx client_max_body_size 与 multipart 上限
OTA_MAX_FILE_SIZE=33554432
# 单任务目标设备数上限
OTA_TASK_MAX_DEVICES=500
# 下发巡检间隔（毫秒），0 关闭
OTA_DISPATCH_INTERVAL_MS=60000
# 单轮下发批量上限
OTA_DISPATCH_BATCH_SIZE=200
# 任务超时时长（毫秒，默认 24h）；超时仍无终态回传的记录置 TIMEOUT
OTA_TASK_TIMEOUT_MS=86400000

# T-32 OTA 灰度与固件校验：设备级互斥策略。目标设备已在其他升级任务中时，
# SKIP=静默剔除并继续建任务（批量运维默认），REJECT=整单拒绝（要求清单完全一致）。
# 取值 SKIP / REJECT
OTA_DEVICE_CONFLICT_POLICY=SKIP

# 灰度批次自动推进间隔（毫秒）。0 = 仅由控制台「推进下一批」手动触发。
# 大于 0 时巡检会在「上一批全部收口」且间隔到期后自动开下一批。
OTA_BATCH_INTERVAL_MS=0

# 单轮巡检最多自动推进几个批次
OTA_BATCH_ADVANCE_BATCH_SIZE=5

# 灰度分批时的默认每批台数（创建请求未指定 batchSize 时取此值）
OTA_DEFAULT_BATCH_SIZE=10

# 固件完整性校验是否强制。false（默认）= 设备未回传 md5 仍放行成功，
# 兼容未升级固件的老设备；true = 未回传 md5 的 success 一律判失败。
# 注意：无论本开关如何，设备回传的 md5 与平台不一致时一律判失败。
OTA_VERIFY_REQUIRED=false

# ========== HTTP 上报（T-24 多协议接入） ==========
# 端点与设备凭据过滤器总开关：置 false 时 /api/http-ingest/** 直接 404
HTTP_INGEST_ENABLED=true
# 单次上报载荷上限（字节，默认 64KB）
HTTP_INGEST_MAX_PAYLOAD_BYTES=65536
# 设备凭据 401 响应头 WWW-Authenticate 的 realm 值
HTTP_INGEST_REALM=mqtt-cloud-device

# ========== 认证方式扩展（T-25） ==========
# 两种方式默认关闭：关闭时产品不允许选择 X.509 / JWT，签发接口报错；
# SECRET 认证与平台自身登录不受影响。分流依据是产品 auth_mode，与开关无关。
AUTH_X509_ENABLED=false
# CA 证书与私钥的容器内路径，来自 docker/certs 目录的只读挂载（见 docker/certs/README.md）
AUTH_X509_CA_CERT=/etc/mqtt/certs/ca.crt
AUTH_X509_CA_KEY=/etc/mqtt/certs/ca.key
# 签发证书的有效期天数
AUTH_X509_VALIDITY_DAYS=365
AUTH_JWT_ENABLED=false
# 设备令牌签名密钥，不得与平台 JWT_SECRET 复用；置 AUTH_JWT_ENABLED=true 时必须配置
AUTH_JWT_SECRET=
# 设备令牌有效期（秒）
AUTH_JWT_TTL_SECONDS=3600

# ========== MQTT TLS（T-25，X.509 认证前置） ==========
# 8883 端口映射与 ssl 监听器开关；置 false 时 8883 仍映射但不监听
MQTT_TLS_PORT=8883
MQTT_TLS_ENABLED=true
# 服务端证书 / 私钥 / 受信 CA 链在 emqx 容器内的路径，
# 默认取镜像自带演示证书；启用自有证书时改为 etc/mqtt-certs/ 下的文件名
MQTT_TLS_CERTFILE=etc/certs/cert.pem
MQTT_TLS_KEYFILE=etc/certs/key.pem
MQTT_TLS_CACERTFILE=etc/certs/cacert.pem
# verify_peer 才会向客户端索要证书（X.509 认证的必要条件）；
# fail_if_no_peer_cert 固定 false，使不带证书的 SECRET / JWT 设备仍可走 TLS 接入
MQTT_TLS_VERIFY=verify_peer

# ========== 子设备与网关代理接入（T-26） ==========
# 拓扑总开关：置 false 时拓扑端点直接 404、授权委托分支不生效，
# 既有直连设备链路不受影响，用于现场回滚
DEVICE_TOPOLOGY_ENABLED=true
# 拓扑深度上限；低于 2 视为仅允许直连设备，不接受任何挂载
DEVICE_TOPOLOGY_MAX_DEPTH=5
# 单网关子设备数量上限
DEVICE_TOPOLOGY_MAX_SUB_DEVICES_PER_GATEWAY=200

# ========== 通知渠道扩展（T-27） ==========
# 新增能力总开关：置 false 时渠道与升级端点直接 404、站内信不再新增、
# 邮件与短信不投递、升级巡检不注册；既有 Webhook 告警通知不受影响，用于现场回滚
NOTIFICATION_ENABLED=true
# 站内信通道开关
NOTIFICATION_INAPP_ENABLED=true
# 邮件渠道开关（需配套 SMTP 配置，见 SPRING_MAIL_*）
NOTIFICATION_EMAIL_ENABLED=true
# 短信渠道开关（走通用 HTTP 供应商，渠道配置中填写）
NOTIFICATION_SMS_ENABLED=true
# 单用户渠道数上限 / 升级策略数上限
NOTIFICATION_MAX_CHANNELS_PER_USER=20
NOTIFICATION_MAX_ESCALATION_POLICIES_PER_USER=20
# 单条告警最大升级级数
NOTIFICATION_MAX_ESCALATION_LEVEL=3
# 单用户站内信保留上限（清理最旧已读），0 表示不清理
NOTIFICATION_INAPP_RETENTION_PER_USER=500
# 投递重试：最大尝试次数 / 退避基数（秒）/ 巡检间隔（毫秒，0 关闭）/ 单轮上限 / 保留天数
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=3
NOTIFICATION_DELIVERY_BACKOFF_SECONDS=60
NOTIFICATION_DELIVERY_SWEEP_INTERVAL_MS=60000
NOTIFICATION_DELIVERY_BATCH_SIZE=200
NOTIFICATION_DELIVERY_RETENTION_DAYS=30
# 投递线程池核心 / 最大线程数与队列容量，以及单渠道投递超时（毫秒）
NOTIFICATION_DELIVERY_EXECUTOR_CORE_SIZE=2
NOTIFICATION_DELIVERY_EXECUTOR_MAX_SIZE=8
NOTIFICATION_DELIVERY_EXECUTOR_QUEUE_CAPACITY=500
NOTIFICATION_DELIVERY_TIMEOUT_MS=5000
# 升级巡检：间隔（毫秒，0 关闭）/ 单轮上限
NOTIFICATION_ESCALATION_SWEEP_INTERVAL_MS=60000
NOTIFICATION_ESCALATION_BATCH_SIZE=200

# ========== 规则与告警作用域（T-28） ==========
# 单条规则 / 告警作用域内分组或标签的数量上限，超出按 6268 / 6269 拒绝
SCOPE_MAX_TARGETS=50

# ========== 邮件渠道 SMTP（T-27，可选） ==========
# 仅当启用 EMAIL 渠道且未在渠道配置中单独填写 SMTP 时生效
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ========== 运行 profile ==========
# 生产固定为 prod：收敛日志级别、关闭 SQL 输出、收紧 health 明细。
# 仅本地排障时临时改为 dev，切勿在部署环境使用。
SPRING_PROFILES_ACTIVE=prod