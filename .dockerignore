# ============================================================
# Docker 构建上下文过滤
# 上下文为仓库根目录，需排除依赖、产物、密钥与无关目录
# ============================================================

# 版本控制与编辑器
.git
.gitignore
.gitattributes
.idea
.vscode
.claude

# 依赖目录（容器内重新安装）
**/node_modules
**/.m2

# 构建产物（容器内重新构建）
**/target
**/dist
**/build
**/out

# 环境变量与密钥（严禁进入镜像）
.env
.env.local
.env.*.local
*.pem
*.key
pwfile

# 本地运行数据与日志
*.log
logs
data
**/*.db
**/*.sqlite

# 文档与无关子项目
docs
sketch_jul21a
**/*.md