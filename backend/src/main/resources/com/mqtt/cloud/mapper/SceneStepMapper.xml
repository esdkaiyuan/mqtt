<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mqtt.cloud.mapper.SceneStepMapper">

    <sql id="stepColumns">
        id, scene_id, seq, delay_seconds, action_type, target_type, target_config,
        action_config, enabled, created_at, updated_at
    </sql>

    <!-- 某场景全部步骤（按 seq 升序，即执行顺序） -->
    <select id="selectBySceneId" resultType="com.mqtt.cloud.entity.SceneStep">
        SELECT <include refid="stepColumns"/>
        FROM scene_step
        WHERE scene_id = #{sceneId}
        ORDER BY seq ASC
    </select>

    <!-- 整体替换步骤：先物理删除旧行，再重新插入（步骤无逻辑删除列） -->
    <delete id="deleteBySceneId">
        DELETE FROM scene_step
        WHERE scene_id = #{sceneId}
    </delete>

</mapper>