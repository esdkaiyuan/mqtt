<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mqtt.cloud.mapper.DeviceTagRelationMapper">

    <!-- 唯一键 uk_device_tag 去重：重复关联幂等成功，返回实际新增行数。
         调用方须保证 deviceIds 非空（空集合会生成非法 VALUES 子句）。 -->
    <insert id="insertIgnoreBatch">
        INSERT IGNORE INTO device_tag_relation (device_id, tag_id, created_at)
        VALUES
        <foreach collection="deviceIds" item="deviceId" separator=",">
            (#{deviceId}, #{tagId}, #{createdAt})
        </foreach>
    </insert>

    <delete id="deleteByDeviceIdsAndTag">
        DELETE FROM device_tag_relation
        WHERE tag_id = #{tagId}
          AND device_id IN
        <foreach collection="deviceIds" item="deviceId" open="(" separator="," close=")">
            #{deviceId}
        </foreach>
    </delete>

    <delete id="deleteByDeviceIds">
        DELETE FROM device_tag_relation
        WHERE device_id IN
        <foreach collection="deviceIds" item="deviceId" open="(" separator="," close=")">
            #{deviceId}
        </foreach>
    </delete>

    <delete id="deleteByTagId">
        DELETE FROM device_tag_relation
        WHERE tag_id = #{tagId}
    </delete>

    <select id="selectDeviceIdsByTagIds" resultType="java.lang.Long">
        SELECT DISTINCT device_id
        FROM device_tag_relation
        WHERE tag_id IN
        <foreach collection="tagIds" item="tagId" open="(" separator="," close=")">
            #{tagId}
        </foreach>
    </select>

    <select id="selectByDeviceIds" resultType="com.mqtt.cloud.entity.DeviceTagRelation">
        SELECT id, device_id, tag_id, created_at
        FROM device_tag_relation
        WHERE device_id IN
        <foreach collection="deviceIds" item="deviceId" open="(" separator="," close=")">
            #{deviceId}
        </foreach>
    </select>

    <select id="countByTagId" resultType="int">
        SELECT COUNT(*)
        FROM device_tag_relation
        WHERE tag_id = #{tagId}
    </select>

</mapper>